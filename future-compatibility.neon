# Opt-in analysis for extension code that must run on the current and the next Contena major.
#
# includes:
#     - vendor/contena-cms/phpstan-contena/future-compatibility.neon

services:
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\AnnouncedParameterCountIgnoreExtension
        tags: [phpstan.ignoreErrorExtension]
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\AnnouncedTypeResolver
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\ClassMovedUsage
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\FutureClassMovedUsageRule
        tags: [phpstan.rules.rule]
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\FutureClassMovedExpressionUsageRule
        tags: [phpstan.rules.rule]
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\FutureCallSiteRule
        tags: [phpstan.rules.rule]
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\FuturePropertyCompatibilityRule
        tags: [phpstan.rules.rule]
    -
        class: Contena\PhpStan\Rule\FutureCompatibility\FutureExtensionRule
        tags: [phpstan.rules.rule]
    -
        class: Contena\PhpStan\Type\FutureReturnTypeExtension
        tags: [phpstan.broker.expressionTypeResolverExtension]
    -
        class: Contena\PhpStan\Type\FuturePropertyTypeExtension
        tags: [phpstan.broker.expressionTypeResolverExtension]
